      <xs:enumeration value="G3">
        <!--Goods- Purchase of High Value Assets-->
      </xs:enumeration>
      <xs:enumeration value="G4">
        <!--Goods- Trade Based Money Laundering-->
      </xs:enumeration>
      <xs:enumeration value="G5">
        <!--Goods/Assets- Buying and selling shares/bonds/funds etc. within short timeframes-->
